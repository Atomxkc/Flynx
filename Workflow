name: Build Flynx APK (Release)

on:
  push:
    branches: [main, master]
  workflow_dispatch:
    inputs:
      version:
        description: 'Version name'
        required: true
        default: '4.0.0-expressive'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3
        with:
          api-level: 36
          ndk-version: r27c
          ndk: false
          cmake: false
          build-tools: "36.0.0"

      - name: Build Release APK
        run: |
          cd flynx
          chmod +x ./gradlew
          ./gradlew assembleRelease --no-daemon

      - name: Align and sign (optional)
        run: |
          # Uses debug keystore so the APK is installable directly
          # For production signing, add a keystore step here
          echo "APK built with debug signing for easy installation"

      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: Flynx-release
          path: flynx/app/build/outputs/apk/release/app-release-unsigned.apk
          if-no-files-found: continue

      - name: Upload aligned APK
        uses: actions/upload-artifact@v4
        with:
          name: Flynx-release-aligned
          path: flynx/app/build/outputs/apk/release/app-release.apk
          if-no-files-found: continue
